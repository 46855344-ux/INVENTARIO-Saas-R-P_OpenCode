# =============================================================================
# Plantilla de variables de entorno — SAAS-INVERSIONES-RP
# Copiar a .env y ajustar los valores según el entorno.
# =============================================================================

# --- Aplicación -------------------------------------------------------------
APP_NAME="SAAS Inversiones R&P"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# --- Backend / Laravel ------------------------------------------------------
# Las fechas se guardan en UTC; la zona de presentación se define aparte.
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Frontend ---------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://localhost:8000/api
VITE_APP_ENV=local

# --- Base de datos (MySQL) --------------------------------------------------
# En Docker el host es "db"; con XAMPP/MySQL local usar 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saas_inversiones_rp
DB_USERNAME=saas
DB_PASSWORD=secret

# --- Sesión y caché ---------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Correo -----------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@saas-inversiones-rp.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Pruebas E2E (Cypress) --------------------------------------------------
CYPRESS_BASE_URL=http://localhost:5173
CYPRESS_API_URL=http://localhost:8000/api

# --- Docker -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=saas-inversiones-rp
DOCKER_APP_PORT=8000
DOCKER_WEB_PORT=5173
DOCKER_DB_PORT=3306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=saas_inversiones_rp
MYSQL_USER=saas
MYSQL_PASSWORD=secret
