# syntax=docker/dockerfile:1
#
# Imagen de desarrollo del backend Laravel.
# Contexto de build: raíz del repositorio (ver docker-compose.yml).
#
FROM php:8.3-cli

# Extensiones necesarias para Laravel + MySQL + pruebas.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        unzip \
        libzip-dev \
        libonig-dev \
        libicu-dev \
        libpng-dev \
        default-mysql-client \
    && docker-php-ext-install \
        bcmath \
        ctype \
        intl \
        mbstring \
        pdo_mysql \
        zip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Composer 2.
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Configuración de PHP del proyecto.
COPY infrastructure/docker/php.ini /usr/local/etc/php/conf.d/zz-saas.ini

WORKDIR /var/www/html

# Copiamos el backend para que la imagen funcione sin bind mount.
COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-interaction --prefer-dist --no-scripts --no-autoloader

COPY backend/ ./
RUN composer dump-autoload --optimize

COPY infrastructure/docker/entrypoint.backend.sh /usr/local/bin/entrypoint-backend
RUN chmod +x /usr/local/bin/entrypoint-backend

EXPOSE 8000

ENTRYPOINT ["entrypoint-backend"]

# Se usa el servidor embebido de PHP directamente en lugar de `artisan serve`.
# `artisan serve` filtra las variables de entorno al proceso hijo (solo deja
# pasar una lista blanca), por lo que DB_HOST/FRONTEND_URL de compose se
# perdían y la app tomaba los valores de `.env`.
CMD ["sh", "-c", "cd /var/www/html/public && exec php -S 0.0.0.0:8000 /var/www/html/vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php"]
